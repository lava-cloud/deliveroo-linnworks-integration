# ---------------------------------------------------------------------------
# These are the environment variables the app reads.
# In Render, add them under: your service -> Environment.
# Do NOT commit real values to GitHub. This file is just a reference list.
# ---------------------------------------------------------------------------

# Which Deliveroo environment: sandbox (default) or production
DELIV_ENV=sandbox

# Deliveroo OAuth app credentials (already set in Render)
DELIV_CLIENT_ID=
DELIV_CLIENT_SECRET=

# Your Deliveroo brand and site (production: lava-wholesale-gb / 755952).
DELIV_BRAND_ID=
DELIV_SITE_ID=
# Not needed for stock sync (the live menu is addressed by site).
DELIV_CATALOGUE_ID=

# Stock sync changes the LIVE shop, so it stays "staged" (logs only) until
# this is set to live. Out-of-stock items are hidden by default; set
# DELIV_OUT_OF_STOCK_STATUS=unavailable to show them greyed out as sold out
# instead (Deliveroo clears that each morning; the app re-applies it hourly).
DELIV_STOCK_SYNC=
DELIV_OUT_OF_STOCK_STATUS=hidden

# Optional extras you already have
DELIV_ADMIN_ID=
DELIV_COMPANY_ID=

# Linnworks application credentials (add when maintenance ends)
LINNWORKS_APP_ID=
LINNWORKS_APP_SECRET=
LINNWORKS_APP_TOKEN=
LINNWORKS_LOCATION_NAME=Default

# Postgres connection string (Render provides this when you add a database)
DATABASE_URL=

# A random secret so only you can trigger POST /sync/stock
SYNC_SECRET=

# Auto stock-sync interval in minutes (0 = manual only)
STOCK_SYNC_INTERVAL_MINUTES=0
